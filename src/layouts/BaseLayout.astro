---
import '@/styles/global.css';
import Navbar from '@/components/ui/Navbar.astro';
import { t } from '@/i18n/utils.js';

const {
  title       = 'Eudald Bosch - Portfolio',
  lang        = 'es',
  description = 'Portfolio personal de Eudald Bosch, Front-End Engineer especializado en React, Astro y TypeScript.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <Navbar lang={lang} />
    <main class="pt-16">
      <slot />
    </main>
    <footer class="border-t border-[var(--glass-border)] py-8 mt-24">
      <div class="container-section flex flex-col md:flex-row items-center justify-between gap-4 text-[var(--text-muted)] text-sm">
        <p>© {new Date().getFullYear()} Eudald Bosch. {t('footer.rights', lang)}</p>
        <div class="flex gap-6">
          <a
            href={t('social.github', lang)}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--accent)] transition-colors duration-200"
          >GitHub</a>
          <a
            href={t('social.linkedin', lang)}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--accent)] transition-colors duration-200"
          >LinkedIn</a>
        </div>
      </div>
    </footer>
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);
    </script>
  </body>
</html>
