---
---
<canvas id="particle-canvas" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;"></canvas>

<script>
  const canvas = document.getElementById('particle-canvas');
  if (!(canvas instanceof HTMLCanvasElement)) throw new Error('No canvas');
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('No ctx');

  const ACCENT       = '6, 182, 212';
  const N_PARTICLES  = 110;
  const MAX_DIST     = 145;
  const MOUSE_RADIUS = 140;

  let W = 0, H = 0;
  const mouse = { x: -9999, y: -9999 };

  function resize() {
    const rect = canvas.getBoundingClientRect();
    W = canvas.width  = rect.width  || window.innerWidth;
    H = canvas.height = rect.height || window.innerHeight;
  }

  // Coordenadas del raton relativas al canvas
  window.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
  });

  window.addEventListener('mouseleave', () => {
    mouse.x = -9999;
    mouse.y = -9999;
  });

  window.addEventListener('resize', () => {
    resize();
  });

  class Particle {
    constructor() {
      this.x     = Math.random() * W;
      this.y     = Math.random() * H;
      this.vx    = (Math.random() - 0.5) * 0.35;
      this.vy    = (Math.random() - 0.5) * 0.35;
      this.baseR = Math.random() * 1.8 + 0.8;
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;
      if (this.x < 0 || this.x > W) this.vx *= -1;
      if (this.y < 0 || this.y > H) this.vy *= -1;
    }

    draw() {
      const dx = this.x - mouse.x;
      const dy = this.y - mouse.y;
      const t  = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / MOUSE_RADIUS);

      const radius  = this.baseR + t * 3;
      const opacity = 0.18 + t * 0.82;

      ctx.beginPath();
      ctx.arc(this.x, this.y, radius, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${ACCENT}, ${opacity})`;
      ctx.fill();

      if (t > 0.25) {
        ctx.beginPath();
        ctx.arc(this.x, this.y, radius + 4, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${ACCENT}, ${t * 0.2})`;
        ctx.fill();
      }
    }
  }

  function drawLines(particles) {
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const a  = particles[i];
        const b  = particles[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d  = Math.sqrt(dx * dx + dy * dy);
        if (d > MAX_DIST) continue;

        const baseAlpha = (1 - d / MAX_DIST) * 0.12;
        const dma    = Math.sqrt((a.x - mouse.x) ** 2 + (a.y - mouse.y) ** 2);
        const dmb    = Math.sqrt((b.x - mouse.x) ** 2 + (b.y - mouse.y) ** 2);
        const mouseT = Math.max(
          Math.max(0, 1 - dma / MOUSE_RADIUS),
          Math.max(0, 1 - dmb / MOUSE_RADIUS)
        );

        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = `rgba(${ACCENT}, ${baseAlpha + mouseT * 0.55})`;
        ctx.lineWidth   = 0.6 + mouseT * 1.1;
        ctx.stroke();
      }
    }
  }

  // Inicializar cuando el layout este listo
  resize();
  const particles = Array.from({ length: N_PARTICLES }, () => new Particle());

  function loop() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => { p.update(); p.draw(); });
    drawLines(particles);
    requestAnimationFrame(loop);
  }

  loop();
</script>
