---
import { t } from '@/i18n/utils.js';
import ParticleCanvas from '@/components/ui/ParticleCanvas.astro';

const { lang } = Astro.props;
const roles = t('hero.roles', lang) as string[];
---

<section id="hero" class="relative min-h-[100dvh] flex items-center overflow-hidden">
  <ParticleCanvas />

  <div class="container-section relative z-10 w-full py-24">
    <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-12">

      <!-- Texto -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-5 max-w-xl">

        <p class="hero-greeting text-xs tracking-[0.3em] uppercase text-[var(--text-muted)] opacity-0">
          {t('hero.greeting', lang)}
        </p>

        <h1 class="hero-name text-5xl md:text-6xl lg:text-7xl font-bold text-[var(--text-primary)] leading-tight opacity-0">
          Eudald <span class="text-[var(--accent)]">Bosch</span>
        </h1>

        <!-- Typewriter -->
        <div class="hero-role h-8 flex items-center opacity-0">
          <span id="typewriter" class="text-lg md:text-xl text-[var(--text-muted)] font-medium"></span>
          <span class="typewriter-cursor ml-0.5 inline-block w-0.5 h-5 bg-[var(--accent)] animate-pulse"></span>
        </div>

        <p class="hero-available text-xs text-[var(--text-muted)] tracking-wide opacity-0">
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--accent)] mr-2 animate-pulse"></span>
          {t('hero.available', lang)}
        </p>

        <!-- CTAs -->
        <div class="hero-ctas flex flex-wrap gap-3 opacity-0">
          <a href="#projects" class="glass glass-hover px-6 py-3 text-[var(--accent)] font-medium text-sm">
            {t('hero.cta', lang)}
          </a>
          <a
            href={t('social.github', lang) as string}
            target="_blank"
            rel="noopener noreferrer"
            class="glass glass-hover px-6 py-3 text-[var(--text-muted)] font-medium text-sm flex items-center gap-2"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a
            href={t('social.linkedin', lang) as string}
            target="_blank"
            rel="noopener noreferrer"
            class="glass glass-hover px-6 py-3 text-[var(--text-muted)] font-medium text-sm flex items-center gap-2"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>

      </div>

      <!-- Foto -->
      <div class="hero-photo opacity-0 shrink-0">
        <div class="relative w-56 h-56 md:w-64 md:h-64">
          <!-- Anillo exterior giratorio -->
          <div class="absolute inset-0 rounded-full border border-white opacity-10 animate-spin-slow"></div>
          <!-- Anillo interior estático con glow blanco -->
          <div class="absolute inset-2 rounded-full border border-white opacity-20 avatar-ring"></div>
          <!-- Avatar con fondo glass -->
          <div class="absolute inset-4 rounded-full overflow-hidden glass">
            <img src="/images/avatar.png" alt="Eudald Bosch" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Roles como data attribute para leer desde el script -->
  <div id="hero-data" data-roles={JSON.stringify(roles)} style="display:none;"></div>

  <!-- Scroll indicator -->
  <div class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0">
    <span class="text-[var(--text-muted)] text-xs tracking-widest uppercase">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-[var(--accent)] to-transparent"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Leer roles desde el DOM
  const heroData = document.getElementById('hero-data');
  const roles: string[] = JSON.parse(heroData?.dataset.roles ?? '[]');

  // --- Typewriter ---
  const el = document.getElementById('typewriter') as HTMLElement;
  let roleIndex = 0;
  let charIndex = 0;
  let deleting = false;

  function typeStep() {
    const current = roles[roleIndex];
    if (!current) return;
    if (!deleting) {
      charIndex++;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === current.length) {
        deleting = true;
        setTimeout(typeStep, 2000);
        return;
      }
      setTimeout(typeStep, 60);
    } else {
      charIndex--;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        setTimeout(typeStep, 400);
        return;
      }
      setTimeout(typeStep, 35);
    }
  }

  // --- GSAP entrada escalonada ---
  const targets = ['.hero-greeting','.hero-name','.hero-role','.hero-available','.hero-ctas','.hero-photo','.hero-scroll'];

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const tl = gsap.timeline({ defaults: { ease: 'power2.out', duration: 0.6 } });
    tl.fromTo('.hero-greeting', { opacity: 0, y: 20 }, { opacity: 1, y: 0 })
      .fromTo('.hero-name',     { opacity: 0, y: 20 }, { opacity: 1, y: 0 }, '-=0.3')
      .fromTo('.hero-role',     { opacity: 0, y: 20 }, { opacity: 1, y: 0 }, '-=0.3')
      .fromTo('.hero-available',{ opacity: 0, y: 20 }, { opacity: 1, y: 0 }, '-=0.3')
      .fromTo('.hero-ctas',     { opacity: 0, y: 20 }, { opacity: 1, y: 0 }, '-=0.3')
      .fromTo('.hero-photo',    { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1 }, '-=0.4')
      .fromTo('.hero-scroll',   { opacity: 0 }, { opacity: 1 }, '-=0.1')
      .call(() => typeStep());
  });

  mm.add('(prefers-reduced-motion: reduce)', () => {
    gsap.set(targets, { opacity: 1 });
    typeStep();
  });
</script>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 12s linear infinite;
  }
  .avatar-ring {
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.12), inset 0 0 18px rgba(255, 255, 255, 0.04);
  }
</style>
