---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LANGUAGES, t } from '@/i18n/utils.js';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---
<BaseLayout lang={lang} title={`Eudald Bosch - Portfolio`}>
  <main>
    <h1 style="color: var(--accent); text-align: center; margin-top: 40vh;">
      {t('hero.greeting', lang)} {t('hero.name', lang)}
    </h1>
    <p style="color: var(--text-muted); text-align: center;">Setup completo. Listo para construir.</p>
  </main>
</BaseLayout>
